# syntax=docker/dockerfile:1

# ---- deps: production dependencies only, cached on the lockfile ----------
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

# ---- build: full install + compile/bundle (no-op for plain-JS apps) ------
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build --if-present

# ---- runtime: minimal image, non-root -----------------------------------
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./

# TODO: keep the line that matches your app; delete the other.
#   Build step emits dist/:
COPY --from=build /app/dist ./dist
#   Plain-ESM app, no build step:
# COPY --from=build /app/src ./src

# The official node image ships an unprivileged `node` user (uid 1000).
USER node

# TODO: the port the app listens on (keep in sync with the app's config).
EXPOSE 3000

# TODO: your start command (from package.json "start" / main entrypoint).
CMD ["node", "dist/server.js"]
