# syntax=docker/dockerfile:1

# ---- build: compile the SPA to static assets ----------------------------
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# TODO: build-time env (Vite inlines VITE_* here). Pass via --build-arg if needed.
RUN npm run build

# ---- runtime: serve the static assets with nginx ------------------------
FROM nginx:1.27-alpine AS runtime
# TODO: match your build tool's output dir (Vite: dist, CRA: build).
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
