server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA history fallback: deep links and refreshes serve index.html so the
    # client-side router handles the path instead of nginx returning 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache fingerprinted assets; never cache the HTML entrypoint.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # TODO (optional): same-origin API proxy — uncomment to send /api/* to the
    # backend container (service name `api` on the shared compose network).
    # Lets the browser call /api/... with no CORS and no backend URL in the bundle.
