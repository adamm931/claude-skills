// src/api/{{resource}}/route.js -> /{{resource}}  (collection)
// THIN handlers: validate input at the edge, call ONE service fn, shape the response.
// No SQL, no pg Pool here. Thrown errors reach the error middleware via asyncHandler.

import { z } from 'zod';
import * as {{resource}}Service from '../../services/{{resource}}.service.js';

const create{{Resource}}Schema = z.object({
  // {{ZodFields}}  e.g. name: z.string().min(1),
});

// GET /{{resource}}
export const GET = async (req, res) => {
  const items = await {{resource}}Service.list();
  res.json(items);
};

// POST /{{resource}}
export const POST = async (req, res) => {
  const input = create{{Resource}}Schema.parse(req.body);
  const created = await {{resource}}Service.create(input);
  res.status(201).json(created);
};
