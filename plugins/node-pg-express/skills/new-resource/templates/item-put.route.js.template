// src/api/{{resource}}/[id]/put/route.js -> PUT /{{resource}}/:id   (update)
// schema.json validates both the :id param and the body.

import * as {{resource}}Service from '#services/{{resource}}.service.js';

export default async (req, res) => {
  const { id } = req.valid.params;
  const updated = await {{resource}}Service.update(id, req.valid.body);
  res.ok(updated, { self: ['GET', `/{{resource}}/${id}`] });
};
