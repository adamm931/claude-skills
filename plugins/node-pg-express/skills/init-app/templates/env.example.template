# Copy to .env (and keep .env out of git). config.js validates these at startup.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{projectName}}
PG_POOL_MAX=10
# v1 auth: global API key. Every request needs this in the `x-api-key` header except public paths.
API_KEY=change-me-in-your-env
# Global rate limit (applied app-wide).
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=100
# Logging (Winston: console + rolling daily file). Tune without touching code.
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_ZIP=false
