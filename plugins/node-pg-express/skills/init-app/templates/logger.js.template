// src/lib/logger.js — minimal structured logger + a request-logging middleware.
// Swap the internals for pino in production; the interface stays the same.

const log = (level, msg, meta) =>
  console[level === 'error' ? 'error' : 'log'](
    JSON.stringify({ t: new Date().toISOString(), level, msg, ...meta }),
  );

export const logger = {
  info: (msg, meta) => log('info', msg, meta),
  warn: (msg, meta) => log('warn', msg, meta),
  error: (msg, meta) => log('error', msg, meta),
};

/** Express middleware: log method, path, status, and duration once the response finishes. */
export const requestLogger = (req, res, next) => {
  const start = process.hrtime.bigint();
  res.on('finish', () => {
    const ms = Number(process.hrtime.bigint() - start) / 1e6;
    logger.info('request', { method: req.method, path: req.originalUrl, status: res.statusCode, ms });
  });
  next();
};
