// src/shared-kernel/index.ts

export interface IDomainEvent {
  readonly name: string;
}

export abstract class Entity {
  private _domainEvents: IDomainEvent[] = [];

  get domainEvents(): readonly IDomainEvent[] {
    return this._domainEvents;
  }

  protected raise(event: IDomainEvent): void {
    this._domainEvents.push(event);
  }

  clearDomainEvents(): void {
    this._domainEvents = [];
  }
}

export abstract class AggregateRoot extends Entity {}

export class DomainError extends Error {}

export interface IRequest<TResponse> {
  readonly _response?: TResponse; // phantom type, never read
}

export interface IRequestHandler<TRequest extends IRequest<TResponse>, TResponse> {
  handle(request: TRequest): Promise<TResponse>;
}

export type Next = () => Promise<unknown>;
export type Middleware = (request: object, next: Next) => Promise<unknown>;

// Minimal in-process command/query bus — the MediatR equivalent for this project.
export class Mediator {
  private handlers = new Map<Function, IRequestHandler<any, any>>();
  private middleware: Middleware[] = [];

  register<TRequest extends IRequest<TResponse>, TResponse>(
    requestType: new (...args: any[]) => TRequest,
    handler: IRequestHandler<TRequest, TResponse>,
  ): void {
    this.handlers.set(requestType, handler);
  }

  use(mw: Middleware): void {
    this.middleware.push(mw);
  }

  async send<TResponse>(request: IRequest<TResponse>): Promise<TResponse> {
    const handler = this.handlers.get(request.constructor);
    if (!handler) {
      throw new Error(`No handler registered for ${request.constructor.name}`);
    }

    const chain = this.middleware.reduceRight<Next>(
      (next, mw) => () => mw(request as object, next),
      () => handler.handle(request),
    );
    return chain() as Promise<TResponse>;
  }
}
